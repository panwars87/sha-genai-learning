# Copy to .env (git-ignored) and fill in.  cp .env.example .env
#
# ── Read ONLY by the LiteLLM gateway ─────────────────────────────────────────
# Real vendor keys. App and lesson code never read these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gateway admin ("root") key. Must start with "sk-". Make up a long random value.
#   python3 -c "import secrets; print('sk-admin-' + secrets.token_urlsafe(24))"
LITELLM_MASTER_KEY=

# Postgres where the gateway stores virtual keys and spend.
# Free hosted option: https://neon.tech  (works on Mac and Colab)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: port the gateway listens on (default 4000).
# GATEWAY_PORT=4000

# ── Read by DocuMind (app + lessons) ─────────────────────────────────────────
# A *virtual* key issued by the gateway. Create it in Module 01, lesson L04.
DOCUMIND_API_KEY=
